# ──────────────────────────────────────────────────────────────
#  Scholarly ERP — API environment
#  Copy to .env. Never commit the real one.
# ──────────────────────────────────────────────────────────────

# ── Deployment mode ───────────────────────────────────────────
# saas      -> multi-tenant. One DB, many institutions, platform console,
#              subscriptions + plan limits enforced.
# dedicated -> a single institution owns this deployment. Own DB, no platform
#              console mounted, no subscription gating, every module unlocked.
DEPLOYMENT_MODE=saas

# Dedicated mode only.
DEDICATED_TENANT_SLUG=
DEDICATED_TENANT_NAME=
DEDICATED_LICENSE_KEY=

# ── App ───────────────────────────────────────────────────────
APP_NAME=Scholarly
ENVIRONMENT=development           # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_PORT=8010

# ── Security ──────────────────────────────────────────────────
# Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_MIN_LENGTH=8

# ── Database ──────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=scholarly

# ── CORS ──────────────────────────────────────────────────────
# The web app's origin. Comma-separated for more than one.
CORS_ORIGINS=http://localhost:3000
# Where the browser app runs — emails link back to it.
WEB_APP_URL=http://localhost:3000
# Optional: enables stjohns.yourdomain.com subdomain routing.
TENANT_BASE_DOMAIN=

# ── ImageKit (file + media storage) ───────────────────────────
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_ID=

# ── Platform owner bootstrap (SaaS mode) ──────────────────────
# Seed plans + the platform owner on startup instead of via a shell.
# Needed on hosts with no SSH (Render's free tier). Idempotent, so it is safe
# to leave on across deploys.
BOOTSTRAP_ON_STARTUP=false
PLATFORM_OWNER_EMAIL=owner@example.com
PLATFORM_OWNER_PASSWORD=ChangeMe123!
PLATFORM_OWNER_NAME=Platform Owner

# ══════════════════════════════════════════════════════════════
#  Optional integrations
#  Leave any of these blank: the feature reports itself as "not
#  configured" rather than failing at runtime.
# ══════════════════════════════════════════════════════════════

# ── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ── SMS (any HTTP gateway: MSG91, TextLocal, Fast2SMS, Gupshup) ─
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_AUTH_HEADER=            # e.g. "authkey"; blank sends apikey in the body
SMS_FIELD_TO=mobiles
SMS_FIELD_MESSAGE=message
SMS_FIELD_SENDER=sender

# ── Push (Firebase Cloud Messaging) ───────────────────────────
FCM_SERVER_KEY=

# ── WhatsApp (Meta Cloud API) ─────────────────────────────────
WHATSAPP_API_URL=
WHATSAPP_TOKEN=

# ── Online fee collection (Razorpay) ──────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── AI assistant (Anthropic) ──────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Biometric devices (ZKTeco / ADMS) ─────────────────────────
# Shared secret a device must present. BLANK DISABLES THE ENDPOINT
# rather than leaving it open to anonymous attendance.
BIOMETRIC_DEVICE_KEY=
